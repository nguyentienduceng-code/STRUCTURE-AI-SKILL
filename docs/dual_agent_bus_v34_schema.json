{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DUAL_AGENT_BUS v3.4 Dual-Plane Schema",
  "description": "Tach lop Control Plane (lock, SHA-256, receipt chay ngam) va Presentation Plane (Phieu Tham Tra 3 y tieng Viet + ProductDeliverableGate) cho 2D Cognitive Dispatcher.",
  "schema_version": "3.4.0",
  "type": "object",
  "required": [
    "bus_version",
    "task_id",
    "status",
    "dispatch_2d",
    "bus_meta",
    "human_handoff"
  ],
  "properties": {
    "bus_version": {
      "type": "string",
      "const": "3.4"
    },
    "task_id": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "IN_PROGRESS",
        "NEEDS_PROJECT_CONFIRMATION",
        "BLOCKED_GATE",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "dispatch_2d": {
      "type": "object",
      "required": [
        "domain_skill",
        "engagement_mode",
        "claude_role",
        "allow_script_patch",
        "enforce_deliverable_gate",
        "enforce_jargon_linter"
      ],
      "properties": {
        "domain_skill": { "type": "string" },
        "domain_confidence": { "type": "number" },
        "engagement_mode": {
          "type": "string",
          "enum": ["PRODUCT_COLLAB", "SYSTEM_UPGRADE"]
        },
        "mode_confidence": { "type": "number" },
        "claude_role": {
          "type": "string",
          "enum": ["LEAD_AUDITOR_TCVN", "SOFTWARE_ARCHITECT"]
        },
        "allow_script_patch": { "type": "boolean" },
        "deliverable_dir_posix": { "type": ["string", "null"] },
        "deliverable_dir_win": { "type": ["string", "null"] },
        "expected_extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enforce_deliverable_gate": { "type": "boolean" },
        "enforce_jargon_linter": { "type": "boolean" }
      }
    },
    "bus_meta": {
      "type": "object",
      "description": "Control Plane chay ngam (v3.3 atomic lock, receipts, SHA-256). Khong hien thi trong bao cao nguoi dung o che do PRODUCT_COLLAB.",
      "required": ["lock_owner", "task_started_at_epoch", "evidence_hashes", "receipts"],
      "properties": {
        "lock_owner": { "type": "string" },
        "lock_acquired_at_iso": { "type": "string" },
        "task_started_at_epoch": { "type": "number" },
        "lease_ttl_sec": { "type": "integer", "default": 600 },
        "report_gate_p1": { "type": "string" },
        "mcp_perception_p2": { "type": "boolean" },
        "evidence_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": { "type": "string" },
              "event": { "type": "string" },
              "timestamp_iso": { "type": "string" },
              "gate_status": { "type": "string" }
            }
          }
        }
      }
    },
    "human_handoff": {
      "type": "object",
      "description": "Presentation Plane danh cho nguoi dung ky thuat va Claude o vai tro Chu tri Tham tra.",
      "required": ["handover_prompt", "user_report_vi", "deliverable_gate_status"],
      "properties": {
        "handover_prompt": { "type": "string" },
        "source_scripts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "user_report_vi": { "type": "string" },
        "deliverable_gate_status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "BYPASSED_SYSTEM_MODE",
            "BLOCKED_INVALID_DIR",
            "BLOCKED_MISSING_DELIVERABLE",
            "BLOCKED_JARGON_VIOLATION"
          ]
        },
        "deliverable_gate_message_vi": { "type": "string" },
        "verified_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
