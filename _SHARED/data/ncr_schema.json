{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://google-ai-studio.local/schemas/ncr_schema.json",
  "title": "DCE P0-OPS NCR Back-Loop Record Schema",
  "type": "object",
  "required": [
    "ncr_id",
    "model_id",
    "from_model_version",
    "to_model_version",
    "element_id",
    "field",
    "new_value",
    "source",
    "severity",
    "status",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "ncr_id": { "type": "string", "pattern": "^NCR-[0-9]{3,}$" },
    "model_id": { "type": "string", "minLength": 1 },
    "from_model_version": { "type": "integer", "minimum": 1 },
    "to_model_version": { "type": "integer", "minimum": 2 },
    "element_id": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "old_value": {},
    "new_value": {},
    "reason": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR"] },
    "status": { "type": "string", "enum": ["APPLIED_AND_REGENERATED", "APPLIED_PENDING_REGEN", "REJECTED"] },
    "affected_sheets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
