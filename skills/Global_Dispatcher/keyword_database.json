  "tie_breakers": {
    "description": "Khi 2+ skills cùng match, áp dụng tie-breaker rules theo thứ tự ưu tiên",
    "rules": [
      {
        "rule_id": "TB-01",
        "condition": "SDE_keywords_present AND NOT DE_keywords_present",
        "winner": "Structural_Design_Engineer",
        "reason": "Có keyword tính toán thiết kế, không có keyword review/thẩm tra"
      },
      {
        "rule_id": "TB-02",
        "condition": "DE_keywords_present AND NOT SDE_keywords_present",
        "winner": "Design_Evaluation",
        "reason": "Có keyword review/thẩm tra, không có keyword tính toán thiết kế"
      },
      {
        "rule_id": "TB-03",
        "condition": "SDE_keywords_present AND DE_keywords_present",
        "winner": "PIPELINE:SDE→DE",
        "reason": "Cả tính toán và review → chạy nối tiếp: tính trước, review sau"
      },
      {
        "rule_id": "TB-04",
        "condition": "GEO_keywords_present",
        "winner": "SKILL_GEOTECH",
        "reason": "Keyword địa kỹ thuật luôn thắng tuyệt đối"
      },
      {
        "rule_id": "TB-05",
        "condition": "TI_only AND has_calculation_context",
        "winner": "DELEGATE_TO_PRIMARY",
        "reason": "Technical_Illustrator không bao giờ là skill chính khi có nội dung tính toán"
      },
      {
        "rule_id": "TB-06",
        "condition": "TW_keywords_present",
        "winner": "SKILL_TEMPWORKS",
        "reason": "Keyword cốp pha, ván khuôn, cây chống, temporary works luôn thắng tuyệt đối"
      }
    ]
  },
