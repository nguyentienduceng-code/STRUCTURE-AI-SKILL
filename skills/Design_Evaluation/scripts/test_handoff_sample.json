{"Ten_Du_An": "Dự án Thử nghiệm — Nhà xưởng Công nghiệp", "Hang_Muc": "Phân tích Kết cấu Khung thép Nhà xưởng", "Giai_Doan_TK": "BVTC (Bản vẽ Thi công)", "Ngay": "2026-08-31", "Loai_Phan_Tich": "so_sanh_PA", "Standard_Method": "TCVN 5575:2024, TCVN 2737:2023, TCVN 9386:2025", "Kien_Nghi": "Phê duyệt Phương án 2 — Khung thép tiền chế, tối ưu chi phí 12% và đẩy nhanh tiến độ 30 ngày.", "Trang_Thai": "AT_RISK", "Citations": [{"Ma_Tieu_Chuan": "TCVN 5575", "Nam_Ban_Hanh": "2024", "Dieu_Bang_Muc": "Điều 10.2", "Trang_So": "45", "Trich_Yeu": "Hệ số tin cậy γ_M0 = 1.10 cho thép kết cấu"}, {"Ma_Tieu_Chuan": "TCVN 2737", "Nam_Ban_Hanh": "2023", "Dieu_Bang_Muc": "Bảng 5", "Trang_So": "23", "Trich_Yeu": "Áp lực gió tiêu chuẩn theo vùng II"}, {"Ma_Tieu_Chuan": "TCVN 9386", "Nam_Ban_Hanh": "2025", "Dieu_Bang_Muc": "Điều 6.2", "Trang_So": "67", "Trich_Yeu": "Phổ phản ứng thiết kế cho vùng gia tốc nền 0.15g"}], "Calculation_Logs": [{"Step": "1. Tải trọng", "Static_Scheme": "Tĩnh tải + Hoạt tải", "Formula": "q = γ_G × G + γ_Q × Q", "Citation": {"Ma_TC": "TCVN 2737:2023", "Dieu_Muc": "Đ.4.3"}, "Values": "G = 1.5 kN/m², Q = 2.5 kN/m²", "Result": "q = 1.2×1.5 + 1.5×2.5 = 5.55 kN/m²", "Utilization": 0.78, "Rating": "GREEN", "Remark": "Hệ số tin cậy theo TCVN 2737:2023"}, {"Step": "2. Mô men uốn", "Static_Scheme": "Dầm đơn giản L=8m", "Formula": "M_ed = q × L² / 8", "Citation": {"Ma_TC": "TCVN 5575:2024", "Dieu_Muc": "Đ.10.2"}, "Values": "q = 5.55 kN/m, L = 8m", "Result": "M_ed = 5.55 × 64 / 8 = 44.4 kNm", "Utilization": 0.85, "Rating": "GREEN"}, {"Step": "3. Tiết diện I400", "Static_Scheme": "Dầm thép I400x200", "Formula": "η = M_ed / M_c_Rd", "Citation": {"Ma_TC": "TCVN 5575:2024", "Dieu_Muc": "Đ.10.2"}, "Values": "M_c_Rd = 52.3 kNm", "Result": "η = 44.4 / 52.3 = 0.85", "Utilization": 0.85, "Rating": "GREEN"}, {"Step": "4. LTB (Lateral-Torsional Buckling)", "Static_Scheme": "Dầm không liên kết bên", "Formula": "η_LTB = M_ed / (χ_LT × M_c_Rd)", "Citation": {"Ma_TC": "TCVN 5575:2024", "Dieu_Muc": "Đ.10.5"}, "Values": "χ_LT = 0.85", "Result": "η_LTB = 44.4 / (0.85 × 52.3) = 1.00", "Utilization": 1.0, "Rating": "YELLOW", "Remark": "Cần bố trí liên kết bên"}, {"Step": "5. Độ võng", "Static_Scheme": "Dầm đơn giản", "Formula": "δ = 5 × q × L⁴ / (384 × E × I)", "Citation": {"Ma_TC": "TCVN 5575:2024", "Dieu_Muc": "Đ.11"}, "Values": "q = 5.55 kN/m, L = 8m", "Result": "δ = 12 mm < L/250 = 32 mm", "Utilization": 0.38, "Rating": "GREEN"}], "So_Sanh": {"categories": ["Chi phí (tỷ VNĐ)", "Tiến độ (ngày)", "Khối lượng (tấn)", "Carbon (tCO₂)", "Khả thi"], "plans": {"PA1 (BTCT truyền thống)": [12.5, 240, 0, 850, 70], "PA2 (Khung thép tiền chế)": [11.0, 210, 95, 720, 85], "PA3 (Hỗn hợp BTCT + Thép)": [12.0, 230, 50, 780, 80]}}, "Unverified_Items": ["Chưa có kết quả thí nghiệm địa chất khu vực móng", "Chưa xác nhận tải trọng cầu trục với nhà cung cấp", "PA3 cần kiểm tra thêm tại vị trí nút khung"]}